{
  "name": "figureit",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:privacy": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:privacy": "node scripts/check-privacy.mjs",
    "fetch:tectonic": "node scripts/fetch-tectonic.mjs",
    "check": "pnpm lint && pnpm test && pnpm test:privacy && pnpm build && pnpm check:privacy",
    "bundle": "node scripts/bundle.mjs",
    "cargo": "node scripts/cargo.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
